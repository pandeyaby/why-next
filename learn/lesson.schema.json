{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Why Next? lesson",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "topicId",
  "title",
  "keyIdea",
  "explain",
  "practice",
  "mastery",
  "status",
  "visual"
 ],
 "properties": {
  "topicId": {
   "type": "string",
   "pattern": "^[a-z]{2}_[A-Za-z0-9_-]{10}$"
  },
  "title": {
   "type": "string",
   "minLength": 3
  },
  "keyIdea": {
   "type": "string",
   "minLength": 10
  },
  "status": {
   "enum": [
    "self-checked",
    "expert-reviewed",
    "auto-starter"
   ]
  },
  "familyTip": {
   "type": "string",
   "minLength": 10
  },
  "explain": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kid",
    "adult"
   ],
   "properties": {
    "kid": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "string",
      "minLength": 20
     }
    },
    "adult": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "practice": {
   "type": "array",
   "minItems": 3,
   "maxItems": 5,
   "items": {
    "$ref": "#/definitions/item"
   }
  },
  "mastery": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "passMark",
    "draw",
    "pool"
   ],
   "properties": {
    "passMark": {
     "type": "integer",
     "minimum": 1
    },
    "draw": {
     "type": "integer",
     "minimum": 2,
     "maximum": 5
    },
    "pool": {
     "type": "array",
     "minItems": 6,
     "maxItems": 12,
     "items": {
      "$ref": "#/definitions/item"
     }
    }
   }
  },
  "audience": {
   "enum": [
    "family",
    "learner"
   ],
   "description": "family: early topics a grown-up explores with a child; learner: written to the learner directly"
  },
  "visual": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "caption",
    "opts"
   ],
   "description": "Interactive visual shown under the explanation (learn/vis_*.js). Per-type opts are checked by validate_lessons.py.",
   "properties": {
    "type": {
     "enum": [
      "counters",
      "tenframe",
      "array",
      "share",
      "fracbar",
      "numline",
      "balance",
      "bidmas",
      "longmul",
      "longdiv",
      "plot",
      "rate",
      "power",
      "particles",
      "atom",
      "ptable",
      "balancer",
      "area",
      "sorter",
      "phscale",
      "energy",
      "placevalue",
      "percent",
      "thermo",
      "journey",
      "formula",
      "coords",
      "wholes",
      "expo",
      "roots",
      "grid",
      "symbols",
      "sealed",
      "circuit",
      "light",
      "vlt",
      "polyterms",
      "tiles",
      "vectors",
      "states",
      "separate",
      "matlab",
      "objects",
      "squares",
      "slopes",
      "problab",
      "statlab",
      "numzoom",
      "graphlab",
      "geolab",
      "matrixlab",
      "gaslab",
      "reactlab",
      "wavelab",
      "forcelab",
      "ecolab",
      "platelab",
      "celllab",
      "cyclelab",
      "chainlab",
      "bodylab", "flagderiv", "flagplace", "flagfrac", "flagneg", "flageq", "flagline", "flagarea", "flagatom", "flagacid", "flagstate", "flagprob", "flagpyth",
     "flagenergy",
     "flagcirc",
     "flagwave",
     "flagunit"
     ]
    },
    "caption": {
     "type": "string",
     "minLength": 10,
     "maxLength": 160
    },
    "opts": {
     "type": "object"
    }
   }
  },
  "worked": {
   "type": "object",
   "required": [
    "title",
    "steps"
   ],
   "additionalProperties": false,
   "properties": {
    "title": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "quality": {
   "type": "integer",
   "minimum": 0,
   "maximum": 100
  },
  "lab": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "caption",
    "opts"
   ],
   "description": "Optional second interactive: a lab with sandbox and challenges, shown after the main visual.",
   "properties": {
    "type": {
     "enum": [
      "counters",
      "tenframe",
      "array",
      "share",
      "fracbar",
      "numline",
      "balance",
      "bidmas",
      "longmul",
      "longdiv",
      "plot",
      "rate",
      "power",
      "particles",
      "atom",
      "ptable",
      "balancer",
      "area",
      "sorter",
      "phscale",
      "energy",
      "placevalue",
      "percent",
      "thermo",
      "journey",
      "formula",
      "coords",
      "wholes",
      "expo",
      "roots",
      "grid",
      "symbols",
      "sealed",
      "circuit",
      "light",
      "vlt",
      "polyterms",
      "tiles",
      "vectors",
      "states",
      "separate",
      "matlab",
      "objects",
      "squares",
      "slopes",
      "problab",
      "statlab",
      "numzoom",
      "graphlab",
      "geolab",
      "matrixlab",
      "gaslab",
      "reactlab",
      "wavelab",
      "forcelab",
      "ecolab",
      "platelab",
      "celllab",
      "cyclelab",
      "chainlab",
      "bodylab", "flagderiv", "flagplace", "flagfrac", "flagneg", "flageq", "flagline", "flagarea", "flagatom", "flagacid", "flagstate", "flagprob", "flagpyth",
     "flagenergy",
     "flagcirc",
     "flagwave",
     "flagunit"
     ]
    },
    "caption": {
     "type": "string",
     "minLength": 10,
     "maxLength": 160
    },
    "opts": {
     "type": "object"
    }
   }
  }
 },
 "definitions": {
  "text": {
   "type": "string",
   "minLength": 2
  },
  "item": {
   "type": "object",
   "required": [
    "type",
    "id",
    "prompt",
    "hint",
    "explain"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[pm][0-9]+$"
    },
    "prompt": {
     "$ref": "#/definitions/text"
    },
    "hint": {
     "$ref": "#/definitions/text"
    },
    "explain": {
     "$ref": "#/definitions/text"
    }
   },
   "oneOf": [
    {
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "mc"
      },
      "id": {},
      "prompt": {},
      "hint": {},
      "explain": {},
      "choices": {
       "type": "array",
       "minItems": 2,
       "maxItems": 5,
       "uniqueItems": true,
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "answer": {
       "type": "integer",
       "minimum": 0
      },
      "params": {
       "$ref": "#/definitions/params"
      },
      "where": {
       "$ref": "#/definitions/expr"
      }
     },
     "required": [
      "choices",
      "answer"
     ]
    },
    {
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "numeric"
      },
      "id": {},
      "prompt": {},
      "hint": {},
      "explain": {},
      "answer": {
       "oneOf": [
        {
         "type": "number"
        },
        {
         "$ref": "#/definitions/expr"
        }
       ]
      },
      "tolerance": {
       "type": "number",
       "minimum": 0
      },
      "params": {
       "$ref": "#/definitions/params"
      },
      "where": {
       "$ref": "#/definitions/expr"
      }
     },
     "required": [
      "answer"
     ]
    },
    {
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "order"
      },
      "id": {},
      "prompt": {},
      "hint": {},
      "explain": {},
      "items": {
       "type": "array",
       "minItems": 3,
       "maxItems": 6,
       "uniqueItems": true,
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "params": {
       "$ref": "#/definitions/params"
      },
      "where": {
       "$ref": "#/definitions/expr"
      }
     },
     "required": [
      "items"
     ]
    }
   ]
  },
  "params": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "pattern": "^[a-z]$"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "integer"
    },
    "minItems": 2,
    "maxItems": 2
   }
  },
  "expr": {
   "type": "string",
   "pattern": "^[a-z0-9+\\-*/%(). <>=!&|]+$"
  }
 }
}