{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Why Next? lesson",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "topicId",
  "title",
  "keyIdea",
  "explain",
  "practice",
  "mastery",
  "status",
  "visual"
 ],
 "properties": {
  "topicId": {
   "type": "string",
   "pattern": "^[a-z]{2}_[A-Za-z0-9_-]{10}$"
  },
  "title": {
   "type": "string",
   "minLength": 3
  },
  "keyIdea": {
   "type": "string",
   "minLength": 10
  },
  "status": {
   "enum": [
    "self-checked",
    "expert-reviewed",
    "auto-starter"
   ]
  },
  "familyTip": {
   "type": "string",
   "minLength": 10
  },
  "explain": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kid",
    "adult"
   ],
   "properties": {
    "kid": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "string",
      "minLength": 20
     }
    },
    "adult": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "practice": {
   "type": "array",
   "minItems": 3,
   "maxItems": 5,
   "items": {
    "$ref": "#/definitions/item"
   }
  },
  "mastery": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "passMark",
    "draw",
    "pool"
   ],
   "properties": {
    "passMark": {
     "type": "integer",
     "minimum": 1
    },
    "draw": {
     "type": "integer",
     "minimum": 2,
     "maximum": 5
    },
    "pool": {
     "type": "array",
     "minItems": 6,
     "maxItems": 12,
     "items": {
      "$ref": "#/definitions/item"
     }
    }
   }
  },
  "audience": {
   "enum": [
    "family",
    "learner"
   ],
   "description": "family: early topics a grown-up explores with a child; learner: written to the learner directly"
  },
